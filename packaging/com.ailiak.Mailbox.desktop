[Desktop Entry]
Type=Application
Version=1.0
Name=Mailbox
GenericName=Email Client
Comment=Calm Linux email client — mail stays local, work goes to Ailiak
Exec=mailbox
Icon=com.ailiak.Mailbox
Terminal=false
Categories=Network;Email;Office;
StartupNotify=true
# Must match ViewportBuilder::with_app_id / window WM class
StartupWMClass=com.ailiak.Mailbox
Keywords=email;mail;imap;ailiak;
