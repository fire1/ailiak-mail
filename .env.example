# Copy to `.env` (gitignored) for local OAuth clients.
# Prefer this over hardcoding values in oauth_clients.rs.

# Google Desktop OAuth client
AILIAKMAIL_OAUTH_GOOGLE_CLIENT_ID=
AILIAKMAIL_OAUTH_GOOGLE_CLIENT_SECRET=

# Microsoft (public / native client — ID only)
AILIAKMAIL_OAUTH_MICROSOFT_CLIENT_ID=

# Yahoo (ID + secret)
AILIAKMAIL_OAUTH_YAHOO_CLIENT_ID=
AILIAKMAIL_OAUTH_YAHOO_CLIENT_SECRET=

# Yandex (ID + secret)
AILIAKMAIL_OAUTH_YANDEX_CLIENT_ID=
AILIAKMAIL_OAUTH_YANDEX_CLIENT_SECRET=

# Logo.dev — company logos for Staks / list avatars (https://www.logo.dev)
# Publishable key (pk_) is used for img.logo.dev CDN. Secret (sk_) for API.
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=
